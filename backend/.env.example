# Copy this file to .env and fill in your own values.

# Required: free API key from Google AI Studio (https://aistudio.google.com).
# Used by LangChain's Google embeddings and chat model.
GOOGLE_API_KEY=your-key-here

# Optional: minimum similarity score for retrieved chunks (default 0.6).
RELEVANCE_LIMIT=0.6

# Optional: comma-separated list of frontend origins allowed by CORS.
# Example: ALLOWED_ORIGINS=https://rag-documentation-chatbot.vercel.app
ALLOWED_ORIGINS=
